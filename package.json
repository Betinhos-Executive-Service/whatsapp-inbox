{
  "name": "whatsapp-inbox",
  "version": "0.0.12",
  "private": true,
  "type": "module",
  "description": "Inbox local e leve para gerir e classificar conversas do WhatsApp, com classificação Jev.",
  "productName": "WhatsApp Inbox",
  "main": "dist-electron/main.mjs",
  "author": "Betinhos Executive Service",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24"
  },
  "config": {
    "port": 38291
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && node server/main.ts",
    "serve": "node server/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "app": "node scripts/desktop.mjs --run",
    "exe": "node scripts/desktop.mjs",
    "release": "node scripts/desktop.mjs --publish"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "electron-updater": "6.8.9",
    "node-llama-cpp": "3.22.1",
    "pino": "9.14.0",
    "qrcode": "1.5.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@types/node": "24.19.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3"
  },
  "build": {
    "appId": "br.com.betinhos.whatsapp-inbox",
    "productName": "WhatsApp Inbox",
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!**/node_modules/@node-llama-cpp/*cuda*/**",
      "!**/node_modules/@node-llama-cpp/*arm64*/**",
      "!**/node_modules/@node-llama-cpp/*linux*/**",
      "!**/node_modules/@node-llama-cpp/*mac*/**",
      "!**/node_modules/node-llama-cpp/llama/**/*.{cpp,c,h,hpp,cmake,txt,md}"
    ],
    "win": {
      "icon": "dist/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "WhatsApp Inbox",
      "artifactName": "WhatsApp-Inbox-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Betinhos-Executive-Service",
        "repo": "whatsapp-inbox",
        "releaseType": "release"
      }
    ],
    "asarUnpack": [
      "**/node_modules/node-llama-cpp/**",
      "**/node_modules/@node-llama-cpp/**"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Betinhos-Executive-Service/whatsapp-inbox.git"
  }
}
