+// patch (WhatsApp Inbox): grava num temporário e troca pelo rename, para que uma queda no meio da escrita
+// (atualização, desligamento) nunca deixe um arquivo de chave truncado: a leitura devolveria null e a
+// sessão daquele contato seria recriada do zero. No Windows o rename falha se outro processo (antivírus,
+// indexador) estiver com o arquivo aberto: tenta de novo e, por último, grava direto, como antes.
+const writeAtomic = async (filePath, content) => {
+    const tmpPath = `${filePath}.tmp`;
+    const handle = await open(tmpPath, 'w');
+    try {
+        await handle.writeFile(content);
+        await handle.sync();
+    }
+    finally {
+        await handle.close();
+    }
+    for (let attempt = 1;; attempt++) {
+        try {
+            return await rename(tmpPath, filePath);
+        }
+        catch (error) {
+            if (!['EPERM', 'EACCES', 'EBUSY'].includes(error.code))
+                throw error;
+            if (attempt === 3) {
+                await unlink(tmpPath).catch(() => { });
+                return writeFile(filePath, content);
+            }
+            await new Promise(resolve => setTimeout(resolve, 50 * attempt));
+        }
+    }
